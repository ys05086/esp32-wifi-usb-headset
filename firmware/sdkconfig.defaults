CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
# The main task answers setup commands on COM (cJSON, NVS, Wi-Fi config).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# The network stack stays on core 0 with Wi-Fi; core 1 is the USB audio core.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_UAC_TINYUSB_TASK_CORE=1
CONFIG_UAC_TINYUSB_TASK_PRIORITY=8
CONFIG_UAC_MIC_TASK_CORE=1
# Bounded 480-frame PCM copy must run before deferred USB management work.
CONFIG_UAC_MIC_TASK_PRIORITY=9
CONFIG_UAC_SPK_TASK_CORE=1
CONFIG_UAC_SPK_TASK_PRIORITY=6
CONFIG_UAC_TUSB_PRODUCT="ESP32 Wi-Fi Headset"
CONFIG_UAC_TUSB_MANUFACTURER="ESP32 Audio Bridge"
CONFIG_UAC_TUSB_SERIAL_NUM="S3-WIFI-HEADSET-01"
CONFIG_UAC_MIC_CHANNEL_NUM=1
CONFIG_UAC_SPEAKER_CHANNEL_NUM=2
CONFIG_UAC_SAMPLE_RATE=48000
CONFIG_UAC_BIT_RESOLUTION_16=y
CONFIG_UAC_MIC_INTERVAL_MS=10
CONFIG_UAC_SUPPORT_MACOS=y
